# ---- 通用忽略 ----
__pycache__/
*.pyc
.pytest_cache/
.venv/
Thumbs.db
desktop.ini
.DS_Store
~$*

# 临时文件
*.tmp
*.bak
*.log
!**/process_logs/*.log

# ---- 本地密钥配置（绝不入库） ----
.env
.env.*
**/.env
!**/.env.example

# ---- 打包过程产物（本地保留，不入库） ----
build/
dist/
*.spec
课表提醒-v1.0-旧版.exe

# 通用二进制忽略（但允许用户版分发包例外，见下方 ! 规则）
*.exe
*.pyd
*.dll

